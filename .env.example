# EmailJS Configuration
# Get these values from your EmailJS dashboard: https://www.emailjs.com/
=
# Service ID (from Email Services section)
VITE_EMAILJS_SERVICE_ID=your_service_id_here
=
# Template ID (from Email Templates section)
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
=
# Public Key (from Account > API Keys section) - Please add your public key here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
